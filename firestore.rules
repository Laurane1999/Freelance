rules_version = '2';

// Firestore security rules (docs/12_FIREBASE_RULES).
// Firestore is the single source of truth; validate before writing and keep
// user data secured to its owner. Only the AUTH_SYSTEM phase (users) is in scope.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role of the signed-in user (docs/15_USER_ROLES). Enforces role-restricted
    // actions at the data layer, not just in the UI.
    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isClient() {
      return isSignedIn() && userRole(request.auth.uid) == 'client';
    }

    function isFreelancer() {
      return isSignedIn() && userRole(request.auth.uid) == 'freelance';
    }

    function isValidUser(data) {
      return data.name is string
        && data.name.size() > 0
        && data.email is string
        && data.role in ['client', 'freelance']
        && data.skills is list;
    }

    function isValidService(data) {
      return data.freelanceId is string
        && data.title is string
        && data.title.size() > 0
        && data.price is number
        && data.price >= 0
        && data.description is string;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    function isValidMission(data) {
      return data.clientId is string
        && data.freelanceId is string
        && data.status in ['pending', 'accepted', 'completed', 'cancelled'];
    }

    function isMissionParticipant(data) {
      return isSignedIn()
        && (request.auth.uid == data.clientId || request.auth.uid == data.freelanceId);
    }

    // MARKETPLACE: services are readable by any signed-in user and writable only
    // by their owning freelancer (freelanceId == uid). Only freelancers may
    // create services (docs/15_USER_ROLES: clients cannot create services).
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isFreelancer()
        && request.resource.data.freelanceId == request.auth.uid
        && isValidService(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.freelanceId == request.auth.uid
        && isValidService(request.resource.data)
        && request.resource.data.freelanceId == resource.data.freelanceId;
      allow delete: if isSignedIn() && resource.data.freelanceId == request.auth.uid;
    }

    // MISSIONS: readable and updatable by either participant (client or
    // freelancer). Only a client may open a mission (as `pending`), and the two
    // participants are immutable after creation (docs/15_USER_ROLES: freelancers
    // cannot create missions; clients cannot hire themselves).
    match /missions/{missionId} {
      allow read: if isMissionParticipant(resource.data);
      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.clientId != request.resource.data.freelanceId
        && request.resource.data.status == 'pending'
        && isValidMission(request.resource.data);
      // Freelancer advances the work (accept / decline / complete); the client
      // may only cancel. Participants are immutable.
      allow update: if isMissionParticipant(resource.data)
        && isValidMission(request.resource.data)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.freelanceId == resource.data.freelanceId
        && (
          (request.auth.uid == resource.data.freelanceId
            && request.resource.data.status in ['accepted', 'completed', 'cancelled'])
          || (request.auth.uid == resource.data.clientId
            && request.resource.data.status == 'cancelled')
        );
      allow delete: if false;
    }

    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    // CHAT: conversations are readable/writable only by their participants.
    // Messages live in a subcollection; the sender must be a participant.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in conversationData(conversationId).participants;
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in conversationData(conversationId).participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update, delete: if false;
      }
    }

    // Collections for later roadmap phases are locked until implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
