rules_version = '2';

// Firestore security rules (docs/12_FIREBASE_RULES).
// Firestore is the single source of truth; validate before writing and keep
// user data secured to its owner. Only the AUTH_SYSTEM phase (users) is in scope.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.name is string
        && data.name.size() > 0
        && data.email is string
        && data.role in ['client', 'freelance']
        && data.skills is list;
    }

    function isValidService(data) {
      return data.freelanceId is string
        && data.title is string
        && data.title.size() > 0
        && data.price is number
        && data.price >= 0
        && data.description is string;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    // MARKETPLACE: services are readable by any signed-in user and writable only
    // by their owning freelancer (freelanceId == uid).
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.freelanceId == request.auth.uid
        && isValidService(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.freelanceId == request.auth.uid
        && isValidService(request.resource.data)
        && request.resource.data.freelanceId == resource.data.freelanceId;
      allow delete: if isSignedIn() && resource.data.freelanceId == request.auth.uid;
    }

    // Collections for later roadmap phases are locked until implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
